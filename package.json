{
  "name": "depup-npm",
  "version": "0.0.0",
  "description": "npm packages with updated dependencies",
  "type": "module",
  "scripts": {
    "depup": "node scripts/depup.mjs",
    "depup:publish": "node scripts/depup.mjs --bump-deps --test --publish",
    "cron:discover": "node scripts/cron-discover.mjs",
    "cron:sync": "node scripts/cron-sync.mjs",
    "heal": "node scripts/heal.mjs",
    "refresh-list": "node scripts/refresh-curated-list.mjs",
    "lint": "eslint scripts/**/*.mjs",
    "lint:fix": "eslint scripts/**/*.mjs --fix",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --forceExit --testTimeout=120000",
    "test:unit": "node --experimental-vm-modules node_modules/.bin/jest --testPathIgnorePatterns \"/node_modules/\" \"/\\.test-temp/\" \"/rev-\" \"<rootDir>/depup/\" \"/\\.claude/\" \"integration\\.test\\.js\" --forceExit --testTimeout=120000",
    "test:integration": "node --experimental-vm-modules node_modules/.bin/jest scripts/__tests__/integration.test.js --forceExit --testTimeout=120000",
    "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --coverage --forceExit --testTimeout=120000"
  },
  "dependencies": {
    "chalk": "6.0.0",
    "commander": "15.0.0",
    "inquirer": "14.0.2",
    "npm-registry-fetch": "20.0.1",
    "ora": "9.4.1",
    "pacote": "22.0.0",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "eslint": "10.8.1",
    "jest": "30.4.2",
    "mikey-pro": "10.3.4",
    "prettier": "3.9.6",
    "stylelint": "16.26.1"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "homepage": "https://github.com/depup/npm",
  "repository": "https://github.com/depup/npm",
  "bugs": "https://github.com/depup/npm/issues",
  "license": "MIT",
  "keywords": [
    "depup",
    "npm",
    "dependencies",
    "security",
    "automation"
  ],
  "author": "Mikl Wolfe <wolfe@mikl.io> (https://github.com/chiefmikey)",
  "prettier": "mikey-pro/prettier",
  "overrides": {
    "@boundaries/elements": "2.0.1",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.2.0"
    }
  }
}
