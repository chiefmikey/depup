  "license": "MIT",
  "keywords": [
    "file-entry-cache",
    "depup",
    "updated-dependencies",
    "security",
    "latest",
    "patched",
    "file cache",
    "task cache files",
    "key par",
    "key value",
    "cache"
  ],
  "devDependencies": {
    "pino": "^10.3.1",
    "tsdown": "^0.22.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "flat-cache": "^6.1.23"
  },
  "files": [
