{
  "name": "@depup/sentry__vite-plugin",
  "version": "5.3.0-depup.40",
  "description": "Official Sentry Vite plugin (with updated dependencies)",
  "repository": "git://github.com/getsentry/sentry-javascript-bundler-plugins.git",
