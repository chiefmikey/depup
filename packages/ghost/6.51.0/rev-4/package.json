  "version": "6.51.0-depup.4",
  "description": "The professional publishing platform (with updated dependencies)",
  "author": "Ghost Foundation",
  "homepage": "https://ghost.org",
  "keywords": [
    "ghost",
    "depup",
    "updated-dependencies",
    "security",
    "latest",
    "patched",
    "blog",
    "cms",
    "headless",
    "content",
    "markdown"
