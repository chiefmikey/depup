    "@types/estree": "^1.0.8",
    "ajv": "^8.18.0",
    "cross-spawn": "^7.0.6",
    "debug": "^4.4.3",
    "escape-string-regexp": "^5.0.0",
    "eslint-scope": "^9.1.2",
