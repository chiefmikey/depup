    "cypress": "^14.1.0",
    "ejs": "^3.0.2",
    "eslint": "file:.",
    "eslint-config-eslint": "file:packages/eslint-config-eslint",
    "eslint-plugin-eslint-plugin": "^6.0.0",
    "eslint-plugin-expect-type": "^0.6.0",
    "eslint-plugin-yml": "^1.14.0",
    "eslint-release": "^3.3.0",
    "eslint-rule-extender": "^0.0.1",
    "eslump": "^3.0.0",
    "esprima": "^4.0.1",
    "fs-teardown": "^0.1.3",
    "glob": "^10.0.0",
    "globals": "^16.2.0",
    "got": "^11.8.3",
