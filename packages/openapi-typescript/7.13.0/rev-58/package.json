    "codegen",
    "generation",
    "openapi 3",
    "node"
  ],
  "bugs": {
    "url": "https://github.com/openapi-ts/openapi-typescript/issues"
  },
  "peerDependencies": {
    "typescript": "^5.x"
  },
  "dependencies": {
    "@redocly/openapi-core": "^2.38.0",
