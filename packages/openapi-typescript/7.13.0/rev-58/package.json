      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./*.js": "./*.mjs",
    "./*": "./*"
  },
  "homepage": "https://openapi-ts.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/openapi-ts/openapi-typescript",
