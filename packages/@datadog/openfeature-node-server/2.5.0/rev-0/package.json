{
  "name": "@depup/datadog__openfeature-node-server",
  "version": "2.5.0-depup.0",
  "description": "Node.js server bindings for OpenFeature (wraps @datadog/flagging-core) (with updated dependencies)",
  "license": "Apache-2.0",
  "homepage": "https://github.com/DataDog/openfeature-js-client#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/DataDog/openfeature-js-client.git",
    "directory": "packages/node-server"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "cjs/index.js",
  "module": "esm/index.js",
  "types": "index.d.ts",
  "typesVersions": {
    "*": {
      "rules-based": [
        "rules-based.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "module": "./esm/index.js",
      "default": "./cjs/index.js"
    },
    "./rules-based": {
      "types": "./rules-based.d.ts",
      "module": "./esm/rules-based.js",
      "default": "./cjs/rules-based.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "cjs/",
    "esm/",
    "*.d.ts",
    "changes.json",
    "README.md"
  ],
  "scripts": {
    "pack": "yarn pack",
    "build": "run-p build:cjs build:esm && yarn build:types",
    "build:cjs": "rm -rf cjs && tsc -p tsconfig.cjs.json && yarn replace-build-env cjs",
    "build:esm": "rm -rf esm && tsc -p tsconfig.esm.json && yarn replace-build-env esm",
    "//build:types": "Bundles self-contained declarations for each entrypoint, required for SSI where dd-trace's node_modules can't reach the customer's @openfeature/server-sdk. See https://github.com/DataDog/dd-trace-js/pull/9570",
    "build:types": "node scripts/build-types.js",
    "replace-build-env": "node ../../scripts/build/replace-build-env.js",
    "clean": "rm -rf dist cjs esm index.d.ts rules-based.d.ts",
    "test": "jest --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@datadog/flagging-core": "3.2.0"
  },
  "devDependencies": {
    "@openfeature/core": "1.11.0",
    "@openfeature/server-sdk": "1.22.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "dts-bundle-generator": "^9.0.0",
    "jest": "^30.0.5",
    "npm-run-all": "^4.1.5",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.5.7",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "@datadog/openfeature-node-server",
    "depup",
    "updated-dependencies",
    "security",
    "latest",
    "patched"
  ],
  "depup": {
    "changes": {},
    "depsUpdated": 0,
    "originalPackage": "@datadog/openfeature-node-server",
    "originalVersion": "2.5.0",
    "processedAt": "2026-10-15T00:31:41.330Z",
    "smokeTest": "passed"
  }
}