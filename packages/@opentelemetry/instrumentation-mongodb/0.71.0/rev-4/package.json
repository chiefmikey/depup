{
  "name": "@depup/opentelemetry__instrumentation-mongodb",
  "version": "0.71.0-depup.4",
  "description": "OpenTelemetry instrumentation for `mongodb` database client for MongoDB (with updated dependencies)",
  "main": "build/src/index.js",
  "types": "build/src/index.d.ts",
  "repository": {
    "type": "git",
