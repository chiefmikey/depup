{
  "name": "@depup/opentelemetry__instrumentation-tedious",
  "version": "0.32.0-depup.1",
  "description": "OpenTelemetry instrumentation for `tedious` database client for Microsoft SQL Server (with updated dependencies)",
  "main": "build/src/index.js",
  "types": "build/src/index.d.ts",
