{
  "name": "@depup/opentelemetry__instrumentation-http",
  "version": "0.218.0-depup.7",
  "description": "OpenTelemetry instrumentation for `node:http` and `node:https` http client and server modules (with updated dependencies)",
  "main": "build/src/index.js",
