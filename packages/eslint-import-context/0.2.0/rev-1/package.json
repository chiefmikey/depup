    "stable-hash-x": "^0.2.0"
  },
  "keywords": [
    "eslint-import-context",
    "depup",
    "updated-dependencies",
    "security",
    "latest",
    "patched"
  ],
  "depup": {
    "changes": {
      "get-tsconfig": {
        "from": "^4.10.1",
        "to": "^4.14.0"
      }
    },
    "depsUpdated": 1,
    "originalPackage": "eslint-import-context",
    "originalVersion": "0.2.0",
    "processedAt": "2026-04-15T05:03:33.756Z",
