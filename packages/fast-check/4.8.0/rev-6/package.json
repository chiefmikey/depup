  "scripts": {
    "build:post-build": "sed -i 's/^declare namespace fast_check_default_d_exports {/\\/\\*\\* @public \\*\\/ declare namespace fast_check_default_d_exports {/' lib/fast-check.d.ts && sed -i 's/fast_check_default_d_exports/fc/' lib/fast-check.d.ts && mkdir -p lib/types57 && cp lib/*.d.ts lib/types57/ && for f in lib/types57/*.d.ts; do [ -f \"$f\" ] && sed -i 's/Array<ArrayBuffer>>/Array>/g' \"$f\"; done && cp lib/*.d.ts lib/cjs/ && cp -r lib/types57 lib/cjs/ && cp package.cjs-template.json lib/cjs/package.json",
    "build": "rolldown -c && pnpm run build:post-build",
    "build-ci": "rolldown -c && pnpm run build:post-build",
    "typecheck": "tsc --noEmit",
    "test-bundle": "for f in test-bundle/*.mjs test-bundle/*.cjs; do [ -f \"$f\" ] && echo \"Running ${f##*/}\" && node \"$f\" || exit 1; done",
    "test-legacy-bundle": "nvs add 12.17.0 && for f in test-bundle/*.cjs; do [ -f \"$f\" ] && echo \"Running ${f##*/}\" && $(nvs which 12.17.0) \"$f\" || exit 1; done",
    "api-extractor": "api-extractor run --local"
  },
  "depup": {
    "changes": {
      "pure-rand": {
        "from": "^8.0.0",
        "to": "^8.4.0"
      }
    },
