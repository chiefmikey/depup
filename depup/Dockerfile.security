# DepUp Security Scanner - Pre-publication Security Validation
FROM node:20-alpine

# Install security scanning tools
RUN apk add --no-cache \
    clamav \
    clamav-daemon \
    freshclam \
    git \
    curl \
    wget \
    jq \
    && freshclam --quiet || echo "Warning: ClamAV database update failed - continuing without latest definitions"

# Install additional security tools via npm
RUN npm install -g \
    @snyk/cli \
    audit-ci \
    npm-check-updates \
    && npm cache clean --force

# Create non-root user
RUN addgroup -g 1001 -S depup && \
    adduser -u 1001 -S depup -G depup

WORKDIR /app

# Create npm cache directory writable by depup user
RUN mkdir -p /tmp/npm-cache && chown depup:depup /tmp/npm-cache

USER depup

# Set npm cache to writable location (depup user has no home directory)
ENV NPM_CONFIG_CACHE=/tmp/npm-cache

# Copy security scripts
COPY --chown=depup:depup scripts/security-*.mjs ./scripts/
COPY --chown=depup:depup package*.json ./

RUN npm ci --omit=dev

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD clamscan --version && snyk --version

# Default command
CMD ["node", "scripts/security-scan.mjs"]
