  },
  "homepage": "https://github.com/eslint/rewrite/tree/main/packages/compat#readme",
  "dependencies": {
    "@eslint/core": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "eslint": "^9.27.0"
  },
  "peerDependencies": {
    "eslint": "^8.40 || 9 || 10"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  },
